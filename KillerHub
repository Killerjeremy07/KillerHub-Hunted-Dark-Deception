local Cache = { 
    Shards = {}, 
    Monsters = {}, 
    Exits = {}, 
    Rings = {}, 
    Prompts = {}, 
    Portals = {} 
}

local function isMonster(obj)
    if not obj or not obj.Parent then 
        return false 
    end
    
    if obj == player.Character then 
        return false 
    end
    
    if Players:GetPlayerFromCharacter(obj) then 
        return false 
    end

    if obj:IsA("Model") then
        local root = obj.PrimaryPart or obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso")
        if root then
            local hum = obj:FindFirstChildOfClass("Humanoid")
            local name = string.lower(obj.Name)
            local parentName = string.lower(obj.Parent.Name)
            
            local isSus = name:match("bot") or name:match("killer") or name:match("enemy") or name:match("monster") or name:match("entity") or name:match("chaser") or name:match("slender") or name:match("hunter") or name:match("figure") or name:match("dummy") or name:match("npc") or name:match("nextbot")
            local isParentSus = parentName:match("monster") or parentName:match("killer") or parentName:match("enemy") or parentName:match("entity")
            
            if hum or isSus or isParentSus then
                return true
            end
            
            -- Brute force check: Heeft dit model scripts die ons kunnen doden?
            if obj:FindFirstChild("Damage", true) or obj:FindFirstChild("Kill", true) or obj:FindFirstChild("TouchInterest", true) then
                return true
            end
        end
    end
    
    return false
end

local function isCollectible(obj)
    if not obj or not obj.Parent then 
        return false 
    end
    
    if obj:IsDescendantOf(player.Character) then 
        return false 
    end

    local name = string.lower(obj.Name)
    if name:match("shard") or name:match("crystal") or name:match("gem") or name:match("coin") or name:match("orb") or name:match("collect") then 
        return true 
    end
    
    if obj:IsA("BasePart") and obj:FindFirstChildOfClass("TouchTransmitter") and obj.Size.Magnitude < 15 then 
        if name:match("hitbox") or name:match("kill") or name:match("damage") then 
            return false 
        end
        return true 
    end
    
    return false
end

local function isPortal(obj)
    if not obj or not obj.Parent then 
        return false 
    end
    
    local name = string.lower(obj.Name)
    if name:match("exit") or name:match("escape") or name:match("door") or name:match("finish") or name:match("end") then 
        return true 
    end
    
    if name:match("ring") or name:match("checkpoint") or name:match("portal") or name:match("next") or name:match("zone") then 
        return true 
    end
    
    if obj:IsA("BasePart") and obj.Material == Enum.Material.Neon and obj.Size.Magnitude > 10 and not name:match("shard") then 
        return true 
    end
    
    return false
end

local function getSafePos(obj)
    if obj:IsA("Model") then 
        if obj.PrimaryPart then 
            return obj.PrimaryPart.Position 
        end 
        return obj:GetPivot().Position
    elseif obj:IsA("BasePart") then 
        return obj.Position 
    end 
    return nil
end

local function fireTouch(hrp, obj)
    if not obj or not obj.Parent then return end
    
    local part = obj
    if obj:IsA("Model") then 
        part = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart") 
    end
    
    if part and part:IsA("BasePart") then 
        firetouchinterest(hrp, part, 0) 
        firetouchinterest(hrp, part, 1) 
    end
end

task.spawn(function()
    while task.wait(1.0) do
        local tShards = {}
        local tMonsters = {}
        local tPrompts = {}
        local tPortals = {}
        
        for i, obj in ipairs(Workspace:GetDescendants()) do
            if isMonster(obj) then 
                table.insert(tMonsters, obj)
            elseif isCollectible(obj) then 
                table.insert(tShards, obj)
            elseif isPortal(obj) then 
                table.insert(tPortals, obj)
            elseif obj:IsA("ProximityPrompt") then 
                table.insert(tPrompts, obj) 
            end
            
            if i % 300 == 0 then 
                task.wait() 
            end 
        end
        
        Cache.Monsters = tMonsters 
        Cache.Shards = tShards 
        Cache.Prompts = tPrompts 
        Cache.Portals = tPortals
    end
end)

