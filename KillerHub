local function applyLineESP(obj, name, color)
    local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local targetPart = obj
    if obj:IsA("Model") then
        targetPart = obj.PrimaryPart or obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChildWhichIsA("BasePart")
    end
    
    if not targetPart or not targetPart:IsA("BasePart") then 
        return 
    end

    local boxName = name .. "_Box"
    local bgui = targetPart:FindFirstChild(boxName)
    
    if not bgui then
        bgui = Instance.new("BillboardGui") 
        bgui.Name = boxName 
        bgui.Adornee = targetPart 
        bgui.Size = UDim2.new(4, 0, 4, 0) 
        bgui.AlwaysOnTop = true 
        
        local frame = Instance.new("Frame", bgui) 
        frame.Size = UDim2.new(1, 0, 1, 0) 
        frame.BackgroundTransparency = 0.5 
        frame.BackgroundColor3 = color 
        frame.BorderSizePixel = 2 
        frame.BorderColor3 = Color3.new(0, 0, 0) 
        bgui.Parent = targetPart
    end

    local lineName = name .. "_Line"
    local line = targetPart:FindFirstChild(lineName)
    
    if not line then
        line = Instance.new("LineHandleAdornment")
        line.Name = lineName
        line.Adornee = targetPart
        line.AlwaysOnTop = true 
        line.ZIndex = 5
        line.Thickness = 3
        line.Color3 = color
        line.Parent = targetPart
    end
    
    local targetPos = hrp.Position - Vector3.new(0, 3, 0)
    local localPos = targetPart.CFrame:PointToObjectSpace(targetPos)
    line.CFrame = CFrame.lookAt(Vector3.zero, localPos)
    line.Length = localPos.Magnitude
end

local lastTick = 0
local lastEvade = 0

RunService.RenderStepped:Connect(function()
    pcall(function()
        if C.FullBright then 
            Lighting.Ambient = Color3.fromRGB(255, 255, 255) 
            Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
            Lighting.ColorShift_Bottom = Color3.fromRGB(255, 255, 255) 
            Lighting.ColorShift_Top = Color3.fromRGB(255, 255, 255)
            Lighting.Brightness = 3 
            Lighting.FogEnd = 900000 
            Lighting.FogStart = 900000 
            Lighting.GlobalShadows = false 
            Lighting.ClockTime = 14
            
            for _, v in pairs(Lighting:GetDescendants()) do
                if v:IsA("Atmosphere") or v:IsA("ColorCorrectionEffect") or v:IsA("BloomEffect") or v:IsA("BlurEffect") or v:IsA("SunRaysEffect") then
                    v.Enabled = false
                end
            end
        end

        if C.BloodMoon then
            Lighting.Ambient = Color3.fromRGB(200, 0, 0)
            Lighting.OutdoorAmbient = Color3.fromRGB(150, 0, 0)
            Lighting.ColorShift_Bottom = Color3.fromRGB(255, 0, 0)
            Lighting.ColorShift_Top = Color3.fromRGB(255, 0, 0)
        elseif C.DiscoLight then
            local rainbow = Color3.fromHSV(tick() % 5 / 5, 1, 1)
            Lighting.Ambient = rainbow
            Lighting.OutdoorAmbient = rainbow
            Lighting.ColorShift_Bottom = rainbow
            Lighting.ColorShift_Top = rainbow
        end
        
        if C.UnlockCam then 
            player.CameraMaxZoomDistance = 100000 
            player.CameraMinZoomDistance = 0.5 
            player.CameraMode = Enum.CameraMode.Classic 
        end
        
        local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        if C.TopDownCam then 
            camera.CameraType = Enum.CameraType.Scriptable 
            camera.CFrame = CFrame.new(hrp.Position + Vector3.new(0, 120, 0), hrp.Position) 
        end

        if C.CFrameWalk and not C.Fly then
            local moveDir = Vector3.new(0, 0, 0)
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + camera.CFrame.RightVector end
            
            moveDir = Vector3.new(moveDir.X, 0, moveDir.Z)
            
            if moveDir.Magnitude > 0 then
                moveDir = moveDir.Unit
                hrp.CFrame = hrp.CFrame + (moveDir * (C.CFrameSpeed / 60))
            end
        end
    end)
end)

RunService.Heartbeat:Connect(function()
    pcall(function()
        if tick() - lastTick < 0.1 then return end 
        lastTick = tick()
        
        local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
        
        if C.AirWalk and hrp then 
            AirPlatform.CFrame = CFrame.new(hrp.Position - Vector3.new(0, 3.5, 0)) 
        else 
            AirPlatform.CFrame = CFrame.new(0, 99999, 0) 
        end
        
        if not hrp or not hum then return end
        
        if C.SpeedEnabled then 
            hum.WalkSpeed = 16 * C.SpeedMulti 
        end

        if C.AutoEvade and tick() - lastEvade > 1 then
            for _, m in ipairs(Cache.Monsters) do
                if m and m.Parent then
                    local mHrp = m.PrimaryPart or m:FindFirstChild("HumanoidRootPart") or m:FindFirstChild("Torso") or m:FindFirstChildWhichIsA("BasePart")
                    if mHrp then
                        local distance = (hrp.Position - mHrp.Position).Magnitude
                        if distance < C.EvadeTrigger then
                            hrp.Velocity = Vector3.new(0, 0, 0)
                            hrp.CFrame = hrp.CFrame + Vector3.new(0, C.EvadeHeight, 0) 
                            
                            Library:Notify("EVADED KILLER! Jumping " .. C.EvadeHeight .. " studs up!", 3)
                            lastEvade = tick() 
                            break
                        end
                    end
                end
            end
        end
        
        if C.FreezeMonsters then
            for _, m in ipairs(Cache.Monsters) do
                if m then
                    local mHum = m:FindFirstChildOfClass("Humanoid")
                    if mHum then mHum.WalkSpeed = 0 end
                    
                    for _, part in ipairs(m:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.Anchored = true
                        end
                    end
                    if m:IsA("BasePart") then
                        m.Anchored = true
                    end
                end
            end
        end

        if C.MonsterESP then 
            for _, obj in ipairs(Cache.Monsters) do 
                applyLineESP(obj, "ESP_M", Color3.fromRGB(255, 0, 0)) 
            end 
        end
        
        if C.ShardESP then 
            for _, obj in ipairs(Cache.Shards) do 
                applyLineESP(obj, "ESP_S", Color3.fromRGB(0, 255, 255)) 
            end 
        end
    end)
end)

